# ==============================================================================
# Reel Security Example - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development
# pip install python-dotenv to load automatically

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Debug Mode - Show detailed error messages
# Set to 1 for development, 0 for production
EEL_DEBUG=1

# Allowed WebSocket Origins (comma-separated)
# Localhost is auto-allowed for development
EEL_ALLOWED_ORIGINS=http://localhost:8000

# ==============================================================================
# SESSION SETTINGS
# ==============================================================================

# Secret key for session encryption
# Generate a new one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Change this in production!
SECRET_KEY=demo-secret-key-change-in-production

# Session timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Server host (use 0.0.0.0 for network access)
EEL_HOST=localhost

# Server port
EEL_PORT=8000

# ==============================================================================
# DEMO CREDENTIALS (for testing)
# ==============================================================================
# These are defined in secure_app.py
# Admin: admin / admin123
# User: user / user123

# ==============================================================================
# PRODUCTION DEPLOYMENT EXAMPLE
# ==============================================================================
# For production, uncomment and configure:
#
# EEL_DEBUG=0
# EEL_ALLOWED_ORIGINS=https://yourdomain.com
# SECRET_KEY=your-super-secure-random-key
# SESSION_TIMEOUT=1800
# EEL_HOST=0.0.0.0
# EEL_PORT=443
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
