# ==============================================================================
# Reel Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control (already in .gitignore)

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Debug Mode - Enable detailed error messages
# WARNING: Only enable in development! Disables error sanitization.
# Default: unset (production mode with sanitized errors)
EEL_DEBUG=0

# Allowed WebSocket Origins - Comma-separated list of allowed origins
# Used to prevent CSRF attacks on WebSocket connections
# Localhost variations (127.0.0.1, localhost, 0.0.0.0) are auto-allowed
# Default: http://localhost:8000
# Example: EEL_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
EEL_ALLOWED_ORIGINS=http://localhost:8000

# Maximum WebSocket Message Size (bytes)
# Prevents memory exhaustion attacks through oversized payloads
# Default: 1048576 (1MB)
# EEL_MAX_MESSAGE_SIZE=1048576

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Application Secret Key - Used for session encryption (if implementing sessions)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CHANGE THIS IN PRODUCTION!
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Session Timeout (seconds)
# Default: 3600 (1 hour)
SESSION_TIMEOUT=3600

# ==============================================================================
# SERVER SETTINGS
# ==============================================================================

# Server Host
# Default: localhost
# Use 0.0.0.0 to allow network access (requires authentication!)
EEL_HOST=localhost

# Server Port
# Default: 8000
# Use 0 for auto-assignment
EEL_PORT=8000

# ==============================================================================
# AI/LLM SETTINGS (Optional - for AI-powered apps)
# ==============================================================================

# Local LLM Model Path
# Path to your local LLM model file (.gguf, .bin, etc.)
# LLM_MODEL_PATH=/path/to/models/mistral-7b-instruct-v0.2.Q4_K_M.gguf

# LLM Context Size
# Default: 2048
# LLM_CONTEXT_SIZE=2048

# LLM Temperature
# Default: 0.7 (range 0.0-1.0)
# LLM_TEMPERATURE=0.7

# LLM Max Tokens
# Default: 512
# LLM_MAX_TOKENS=512

# ==============================================================================
# DATABASE SETTINGS (Optional - if using database)
# ==============================================================================

# Database URL
# Examples:
#   SQLite: sqlite:///./app.db
#   PostgreSQL: postgresql://user:password@localhost/dbname
#   MySQL: mysql://user:password@localhost/dbname
# DATABASE_URL=sqlite:///./app.db

# ==============================================================================
# LOGGING SETTINGS
# ==============================================================================

# Log Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Security Log File Path
# Logs all security events (origin rejections, path traversal, rate limits, etc.)
# Leave empty to log to console only
# REEL_LOG_FILE=logs/security.log

# Application Log File Path
# General application logs
# LOG_FILE=logs/reel.log

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Auto-reload on file changes (development only)
# Requires additional tools (e.g., watchdog)
# AUTO_RELOAD=true

# Disable browser cache (development only)
# DISABLE_CACHE=true

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================

# HTTPS/SSL Settings (for production deployment)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# CORS Settings (if needed)
# CORS_ORIGINS=https://example.com,https://app.example.com

# Rate Limiting (if implemented)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# ==============================================================================
# EXAMPLE: Complete Development Configuration
# ==============================================================================
# EEL_DEBUG=1
# EEL_HOST=localhost
# EEL_PORT=8000
# LOG_LEVEL=DEBUG
# SESSION_TIMEOUT=7200

# ==============================================================================
# EXAMPLE: Complete Production Configuration
# ==============================================================================
# EEL_DEBUG=0
# EEL_ALLOWED_ORIGINS=https://app.example.com
# EEL_HOST=0.0.0.0
# EEL_PORT=8000
# SECRET_KEY=your-super-secret-key-here
# SESSION_TIMEOUT=3600
# LOG_LEVEL=WARNING
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem
